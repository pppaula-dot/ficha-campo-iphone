      "id": "esteril",
      "number": "3",
      "title": "DEPÓSITO DE ESTÉREIS",
      "items": [
        {
          "id": "31",
          "text": "3.1- Existência de fragmentos rochosos com volume de, ou superior a, 3 metros cúbicos.",
          "type": "checkbox"
        },
        {
          "id": "32",
          "text": "3.2- Ausência de leira de contenção nas(s) borda(s) da(s) área(s) de basculamento.",
          "type": "checkbox"
        },
        {
          "id": "33",
          "text": "3.3- Área de basculamento não sinalizada.",
          "type": "checkbox"
        },
        {
          "id": "34",
          "text": "3.4- O depósito não possui inclinação suave da borda para o interior da lavra e/ou para o sistema de drenagem.",
          "type": "checkbox"
        },
        {
          "id": "35",
          "text": "3.5- necessidade de instalar e/ou melhorar a contenção na base do depósito, visando evitar a dispersão dos estéreis.",
          "type": "checkbox"
        },
        {
          "id": "36",
          "text": "3.6- Necessário cobrir a(s) parte(s) inativa(s) do(s) depósito(s) com solo e revegetá-las.",
          "type": "checkbox"
        },
        {
          "id": "obs",
          "label": "Observações",
          "type": "long_text"
        }
      ]
    },
    {
      "id": "frente",
      "number": "4",
      "title": "FRENTE DE LAVRA",
      "items": [
        {
          "id": "41",
          "text": "4.1- Requer limpeza de EPI’s, sucatas e embalagens de insumos dispersos na área",
          "type": "checkbox"
        },
        {
          "id": "42",
          "text": "4.2- Identificado fragmento de rocha e/ou solo em grande quantidade na praça, requer limpeza.",
          "type": "checkbox"
        },
        {
          "id": "43",
          "text": "4.3- Trabalhador(es) não utilizando adequadamente os EPI’s",
          "type": "checkbox"
        },
        {
          "id": "44",
          "text": "4.4- Trabalhador(es) em plano inclinado sem fazer uso adequado do cinto paraquedista",
          "type": "checkbox"
        },
        {
          "id": "45",
          "text": "4.5- Quantidade insuficiente de proteção contra radiação UV (guarda-sol e/ou abrigo móvel).",
          "type": "checkbox"
        },
        {
          "id": "46",
          "text": "4.6- Escada(s) em desacordo com as normas de segurança",
          "type": "checkbox"
        },
        {
          "id": "47",
          "label": "4.7- Corte por fio diamantado sendo feito sem",
          "type": "multi_choice",
          "options": [
            "Isolamento",
            "Sinalização"
          ]
        },
        {
          "id": "48",
          "label": "4.8- Dispositivo anti-ricocheteamento ausente nas",
          "type": "multi_choice",
          "options": [
            "Mangueiras",
            "Linhas de distribuição"
          ]
        },
        {
          "id": "49",
          "label": "4.9 Guarda-corpo na(s) crista(s) da(s) bancada(s) em",
          "type": "multi_choice",
          "options": [
            "Quantidade Insuficiente",
            "Inexistente"
          ]
        },
        {
          "id": "410",
          "text": "4.10- Ausência de placas de sinalização na pedreira",
          "type": "checkbox"
        },
        {
          "id": "411",
          "text": "4.11- Cabos-de-aço em más condições de serem utilizados",
          "type": "checkbox"
        },
        {
          "id": "412",
          "label": "4.12- Outro(s)",
          "type": "text"
        },
        {
          "id": "obs",
          "label": "Observações",
          "type": "long_text"
        }
      ]
    },
    {
      "id": "seguranca",
      "number": "5",
      "title": "SEGURANÇA",
      "items": [
        {
          "id": "51",
          "text": "5.1- EPI’s não estão sendo utilizados corretamente/ não existe disponibilidade suficiente de EPI’s para os colaboradores;",
          "type": "checkbox"
        },
        {
          "id": "52",
          "text": "5.2- Não Protegem os operadores da exposição ao sol, chuva e/ou a refrigeração da cabina não funciona;",
          "type": "checkbox"
        },
        {
          "id": "53",
          "text": "5.3- Transporte irregular de colaboradores e/ou visitantes em equipamentos;",
          "type": "checkbox"
        },
        {
          "id": "54",
          "text": "5.4- Veículos não possuem identificação da capacidade de carga e/ou velocidade máxima no(s) seu(s) corpo(s);",
          "type": "checkbox"
        },
        {
          "id": "55",
          "text": "5.5- Veículos não possuem extintor de incêndio preso a um suporte devidamente fixado(s) no(s) seu(s) corpo(s);",
          "type": "checkbox"
        },
        {
          "id": "56",
          "text": "5.6- Manutenção de veículos não está sendo realizada em local apropriado;",
          "type": "checkbox"
        },
        {
          "id": "57",
          "text": "5.7- Veículos apresentam vazamento de óleo, necessitando de revisão/manutenção;",
          "type": "checkbox"
        },
        {
          "id": "58",
          "text": "5.8- Veículos não emitem sinalização sonora;",
          "type": "checkbox"
        },
        {
          "id": "59",
          "text": "5.9- Parte(s) móvel(is) dos veículos não apresentam proteção adequada;",
          "type": "checkbox"
        },
        {
          "id": "510",
          "text": "5.10- Pneus em más condições.",
          "type": "checkbox"
        },
        {
          "id": "obs",
          "label": "Observações",
          "type": "long_text"
        }
      ]
